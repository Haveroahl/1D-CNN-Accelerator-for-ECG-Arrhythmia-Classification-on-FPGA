# ============================================================================
# ecg_de0_top.qsf — DE0-Nano (Cyclone IV E) synth / resource / power project
# ----------------------------------------------------------------------------
# Top = ecg_accelerator_top (ecg_core + avalon_slave), the SAME measurement top
# as ../fpga/ecg_accelerator_top.qsf, retargeted to EP4CE22F17C6 (DE0-Nano).
#
# Goal: an HONEST low-power figure. The DE10-Standard SoC die idles at ~412 mW
# static; the small Cyclone IV E here idles far lower, so total power reflects
# the design. This project measures resource (ALM/LE, M9K, mult), Fmax @ 50 MHz,
# and power (PowerPlay + VCD). It is NOT meant to be programmed for an on-board
# demo (the 83-wire Avalon bus is virtualised — see pin section). The DE10 JTAG
# run already provides the on-board functional demo.
#
# Shared device / RTL / HEX list lives in ecg_de0_common.qsf (sourced below).
# ============================================================================

source ecg_de0_common.qsf

set_global_assignment -name TOP_LEVEL_ENTITY ecg_accelerator_top
set_global_assignment -name PROJECT_CREATION_TIME_DATE "00:00:00  JUN 20, 2026"

# ── Timing constraints — 50 MHz (DE0-Nano CLOCK_50) ─────────────────────────
set_global_assignment -name SDC_FILE ecg_de0_50mhz.sdc

# ── Clock pin: DE0-Nano CLOCK_50 = PIN_R8 (dedicated clock input) ────────────
set_location_assignment PIN_R8 -to clk
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clk

# ── Reset pins: map to two DE0-Nano push-buttons / leave as real inputs ──────
# KEY0 = PIN_J15 (active-low). Use it for the async rst_n; tie sync rst to a
# convenient input. Both are light single-bit pins, so keep them real.
set_location_assignment PIN_J15 -to rst_n
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to rst_n

# ── Avalon-MM bus: 78 wires that we do NOT route to physical pins ────────────
# The DE0-Nano has ~72 usable GPIO and there is no point wiring a 14+32+32-bit
# Avalon bus by hand. Virtualise the bus so the fitter still places/routes the
# full core for accurate resource + power, without needing physical pins.
# (If you later want an on-board functional demo, wrap a JTAG-to-Avalon master
#  like ../fpga/jtag_top.v instead — then these become internal nets.)
set_instance_assignment -name VIRTUAL_PIN ON -to rst
set_instance_assignment -name VIRTUAL_PIN ON -to {avs_address[*]}
set_instance_assignment -name VIRTUAL_PIN ON -to avs_write
set_instance_assignment -name VIRTUAL_PIN ON -to avs_read
set_instance_assignment -name VIRTUAL_PIN ON -to {avs_writedata[*]}
set_instance_assignment -name VIRTUAL_PIN ON -to {avs_readdata[*]}

# ── PowerPlay: feed a real-activity VCD for a trustworthy dynamic figure ─────
# Generate ../fpga/simulation/questa/tb_top.vcd from a full inference, or run a
# DE0-specific sim. Without a VCD the estimate confidence is "Low" (default
# toggle) — do NOT cite that number. See README_DE0.md step 3.
set_global_assignment -name POWER_USE_INPUT_FILES ON
set_global_assignment -name POWER_INPUT_FILE_NAME ../fpga/simulation/questa/tb_top.vcd -section_id tb_top_vcd
set_global_assignment -name POWER_VCD_FILE_START_TIME "0 ns" -section_id tb_top_vcd
set_global_assignment -name POWER_INPUT_FILE_TYPE VCD -section_id tb_top_vcd
set_instance_assignment -name POWER_READ_INPUT_FILE tb_top_vcd -to |

set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top

set_global_assignment -name ORIGINAL_QUARTUS_VERSION 25.1STD.0
set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name AUTO_RAM_RECOGNITION ON
set_global_assignment -name VHDL_SHOW_LMF_MAPPING_MESSAGES OFF
set_global_assignment -name VERILOG_SHOW_LMF_MAPPING_MESSAGES OFF
set_global_assignment -name VERILOG_INPUT_VERSION SYSTEMVERILOG_2005
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 256
set_global_assignment -name DEVICE EP4CE22F17C6
set_global_assignment -name OPTIMIZATION_MODE "HIGH PERFORMANCE EFFORT"
set_global_assignment -name SEARCH_PATH ../RTL
set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name FITTER_EFFORT "FAST FIT"
set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "NO HEAT SINK WITH STILL AIR"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"
set_global_assignment -name HEX_FILE ../RTL/flat_weights.hex
set_global_assignment -name HEX_FILE ../RTL/fc_weights.hex
set_global_assignment -name HEX_FILE ../RTL/fc_bias.hex
set_global_assignment -name HEX_FILE ../RTL/conv4_w.hex
set_global_assignment -name HEX_FILE ../RTL/conv3_w.hex
set_global_assignment -name HEX_FILE ../RTL/conv2_w.hex
set_global_assignment -name HEX_FILE ../RTL/conv1_w.hex
set_global_assignment -name HEX_FILE ../RTL/conv_bias.hex
set_global_assignment -name HEX_FILE ../RTL/w_ram0.hex
set_global_assignment -name HEX_FILE ../RTL/w_ram1.hex
set_global_assignment -name HEX_FILE ../RTL/w_ram2.hex
set_global_assignment -name HEX_FILE ../RTL/w_ram3.hex
set_global_assignment -name HEX_FILE ../RTL/w_ram4.hex
set_global_assignment -name HEX_FILE ../RTL/w_ram5.hex
set_global_assignment -name HEX_FILE ../RTL/w_ram6.hex
set_global_assignment -name HEX_FILE ../RTL/w_ram7.hex
set_global_assignment -name VERILOG_FILE rtl_de0/ping_pong_sram.v
set_global_assignment -name VERILOG_FILE rtl_de0/cp_engine.v
set_global_assignment -name VERILOG_FILE ../RTL/input_sram.v
set_global_assignment -name VERILOG_FILE ../RTL/gap_fc_argmax.v
set_global_assignment -name VERILOG_FILE ../RTL/ecg_accelerator_top.v
set_global_assignment -name VERILOG_FILE ../RTL/ecg_core.v
set_global_assignment -name VERILOG_FILE ../RTL/cp_block.v
set_global_assignment -name VERILOG_FILE ../RTL/cp_mac.v
set_global_assignment -name VERILOG_FILE ../RTL/cp_accumulate_rescale.v
set_global_assignment -name VERILOG_FILE ../RTL/cp_pool.v
set_global_assignment -name VERILOG_FILE ../RTL/cnn_controller.v
set_global_assignment -name VERILOG_FILE ../RTL/avalon_slave.v