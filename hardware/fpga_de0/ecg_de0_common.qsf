# ============================================================================
# ecg_de0_common.qsf — shared settings for the DE0-Nano (Cyclone IV E) port
# ----------------------------------------------------------------------------
# Mirror of ../fpga/ecg_common.qsf but retargeted from Cyclone V (DE10-Standard,
# 5CSXFC6D6F31C6) to the DE0-Nano's Cyclone IV E EP4CE22F17C6.
#
# Purpose: obtain a HONEST low-power number on a leakage-appropriate die. The
# DE10-Standard SoC die spends ~412 mW just on static leakage (large 28 nm die +
# unused hard ARM core); the DE0-Nano's small 60 nm Cyclone IV E typically idles
# at ~80-100 mW, so total power reflects the design rather than the fabric.
#
# Most RTL is REUSED unchanged from ../RTL/. The two memory-bearing modules are
# FORKED into rtl_de0/ with the only change being the block-RAM hint:
#   - ping_pong_sram.v : ramstyle "M10K" -> "M9K"  (16 banks, 512x8 each)
#   - cp_engine.v      : w_ram0..7 "M10K" -> "M9K"; b_store MLAB hint dropped
# Cyclone IV E has no M10K/MLAB primitive — its block RAM is the M9K. Forking
# (rather than relying on Quartus to silently ignore the bad hint) guarantees the
# SRAMs land in M9K, not in LCELLs, which would wreck both area and power numbers.
# input_sram.v has no explicit hint and infers M9K on its own → kept shared.
# Verify in the fitter report that the 16 ping-pong + 8 weight + 1 input SRAM all
# land in M9K block RAM (Total RAM Blocks), not logic cells.
#
# Each variant .qsf does `source ecg_de0_common.qsf` then adds ONLY its own
# TOP_LEVEL_ENTITY / SDC / pins. This file is NEVER opened as a project.
# ============================================================================

# ── Device: DE0-Nano = Cyclone IV E EP4CE22F17C6 ────────────────────────────
set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE22F17C6
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 25.1STD.0
set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 256

# ── Thermal / power model (Cyclone IV E commercial grade, junction 0..85C) ───
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "NO HEAT SINK WITH STILL AIR"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"

# ── Compile / synthesis options (match Cyclone V project) ───────────────────
set_global_assignment -name OPTIMIZATION_MODE "HIGH PERFORMANCE EFFORT"
set_global_assignment -name FITTER_EFFORT "FAST FIT"
set_global_assignment -name VERILOG_INPUT_VERSION SYSTEMVERILOG_2005
set_global_assignment -name VERILOG_SHOW_LMF_MAPPING_MESSAGES OFF
set_global_assignment -name VHDL_SHOW_LMF_MAPPING_MESSAGES OFF
# Make block-RAM inference explicit since the M10K/MLAB hints don't apply here.
set_global_assignment -name AUTO_RAM_RECOGNITION ON
# $readmemh in cp_engine.v uses bare filenames ("w_ram0.hex" ...). Add ../RTL as a
# synthesis search path so the initial-block memory inits resolve from there
# (the shared hex files live in ../RTL, not in this project dir).
set_global_assignment -name SEARCH_PATH ../RTL

# ── Weight / data HEX (read by $readmemh in the RTL) — reuse ../RTL/ ─────────
set_global_assignment -name HEX_FILE ../RTL/flat_weights.hex
set_global_assignment -name HEX_FILE ../RTL/fc_weights.hex
set_global_assignment -name HEX_FILE ../RTL/fc_bias.hex
set_global_assignment -name HEX_FILE ../RTL/conv4_w.hex
set_global_assignment -name HEX_FILE ../RTL/conv3_w.hex
set_global_assignment -name HEX_FILE ../RTL/conv2_w.hex
set_global_assignment -name HEX_FILE ../RTL/conv1_w.hex
set_global_assignment -name HEX_FILE ../RTL/conv_bias.hex
# Phase B01 per-oc weight RAM init (cp_engine block RAM, unless +define+NO_WEIGHT_INIT)
set_global_assignment -name HEX_FILE ../RTL/w_ram0.hex
set_global_assignment -name HEX_FILE ../RTL/w_ram1.hex
set_global_assignment -name HEX_FILE ../RTL/w_ram2.hex
set_global_assignment -name HEX_FILE ../RTL/w_ram3.hex
set_global_assignment -name HEX_FILE ../RTL/w_ram4.hex
set_global_assignment -name HEX_FILE ../RTL/w_ram5.hex
set_global_assignment -name HEX_FILE ../RTL/w_ram6.hex
set_global_assignment -name HEX_FILE ../RTL/w_ram7.hex

# ── RTL source files ────────────────────────────────────────────────────────
# Two memory modules are forked into rtl_de0/ (M10K -> M9K hint); the rest are
# shared unchanged from ../RTL/. rtl_de0/ MUST come first so its ping_pong_sram /
# cp_engine win over any same-named module — but since ../RTL/ versions are simply
# not listed here, there is no collision.
set_global_assignment -name VERILOG_FILE rtl_de0/ping_pong_sram.v
set_global_assignment -name VERILOG_FILE rtl_de0/cp_engine.v
set_global_assignment -name VERILOG_FILE ../RTL/input_sram.v
set_global_assignment -name VERILOG_FILE ../RTL/gap_fc_argmax.v
set_global_assignment -name VERILOG_FILE ../RTL/ecg_accelerator_top.v
set_global_assignment -name VERILOG_FILE ../RTL/ecg_core.v
set_global_assignment -name VERILOG_FILE ../RTL/cp_block.v
set_global_assignment -name VERILOG_FILE ../RTL/cp_mac.v
set_global_assignment -name VERILOG_FILE ../RTL/cp_accumulate_rescale.v
set_global_assignment -name VERILOG_FILE ../RTL/cp_pool.v
set_global_assignment -name VERILOG_FILE ../RTL/cnn_controller.v
set_global_assignment -name VERILOG_FILE ../RTL/avalon_slave.v
